{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "link-card",
	"main": "src/index.ts",
	"workers_dev": false,
	"compatibility_date": "2026-11-07",
	"cache": {
		"enabled": true,
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
		},
	},
	"upload_source_maps": true,
}
